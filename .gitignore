# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Model weights - tracked in NOTICE.md, not in git (size + provenance)
models/**/*.onnx
models/**/*.pth
models/**/*.npz

# Datasets - never in git. Provenance recorded in NOTICE.md.
data/**
!data/**/.gitkeep
!data/**/README.md

# Site recordings (Phase 0 negative collection) - large, customer premises footage
recordings/

# Runtime artefacts
*.db
*.db-wal
*.db-shm
snapshots/
clips/
logs/
*.log

# Per-deployment config. .env holds camera credentials; zones.yaml is one site's
# polygons drawn on one camera's view. Committing either means the repo carries a
# specific installation's wiring and every install conflicts on it.
# Templates (.env.example, config/zones.example.yaml) are committed instead.
.env
config/*.local.yaml
config/zones.yaml

# OS
Thumbs.db
.DS_Store
