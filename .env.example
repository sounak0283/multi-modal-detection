# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#
# Secrets live here; tuning constants live in config/app.yaml. The split is deliberate:
# app.yaml is committed and reviewed, .env is not. Anything that would be damaging in a
# git history or a support bundle belongs in this file.

# --- Camera (required for live operation) ------------------------------------
# RTSP URL, a video file path, or a local device index.
#   rtsp://user:password@192.168.1.50:554/Streaming/Channels/101
#   0                      (first local webcam)
#   D:/footage/clip.mp4    (file, for development)
FSBD_CAMERA_SOURCE=0

# Optional: a low-resolution substream used for inference while the main stream is
# recorded. If the camera exposes one this is the cheapest performance win available
# (PLAN.md section 11) - it removes almost all decode cost.
# FSBD_CAMERA_SUBSTREAM=rtsp://user:password@192.168.1.50:554/Streaming/Channels/102

FSBD_CAMERA_ID=cam_01

# --- Dashboard ---------------------------------------------------------------
FSBD_API_HOST=127.0.0.1
FSBD_API_PORT=8000

# --- Alerts (Phase 4) --------------------------------------------------------
# Telegram: create a bot with @BotFather, then message it once to get your chat id.
# FSBD_TELEGRAM_TOKEN=123456789:AA...
# FSBD_TELEGRAM_CHAT_ID=-1001234567890

# MQTT, if alerts route into an existing BMS/SCADA instead.
# FSBD_MQTT_HOST=192.168.1.10
# FSBD_MQTT_PORT=1883
# FSBD_MQTT_USER=
# FSBD_MQTT_PASSWORD=

# SMTP, if email alerts.
# FSBD_SMTP_HOST=
# FSBD_SMTP_PORT=587
# FSBD_SMTP_USER=
# FSBD_SMTP_PASSWORD=

# --- Paths (optional overrides) ----------------------------------------------
# FSBD_CONFIG=config/app.yaml
# FSBD_ZONES=config/zones.yaml
