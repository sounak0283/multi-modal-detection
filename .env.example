# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#
# This file holds PER-DEPLOYMENT facts: this camera, this machine, this site. They
# differ per install, so committing them would mean the repository carried one site's
# wiring as if it were product configuration - and every install would conflict on it.
#
# Engineering constants - inference cadences, K-of-N gates, hysteresis defaults - live
# in config/app.yaml instead, because those are identical across installs and worth
# having in git history.
#
# The dashboard's Camera page writes this file directly (dotenv set_key). Hand-editing
# is equally fine; the app reads it on start and after every save.

# --- Camera ------------------------------------------------------------------
# The switch: false reads FSBD_CAMERA_SOURCE (laptop webcam), true reads
# FSBD_CCTV_RTSP_URL (site CCTV). Same pattern as the sibling face-recognition
# deployment, so the two projects configure the same way.
FSBD_USE_CCTV=false

# Used when FSBD_USE_CCTV=false. A bare number is a device index; anything else is
# treated as a video file path, which is how you develop against recorded clips.
FSBD_CAMERA_SOURCE=0

# Used when FSBD_USE_CCTV=true. Contains the camera password - this is the main reason
# the file is git-ignored.
FSBD_CCTV_RTSP_URL=

# Optional low-resolution substream for inference while the main stream is recorded.
# If the camera exposes one this is the cheapest performance win available: it removes
# almost all decode cost (PLAN.md section 11).
# FSBD_CAMERA_SUBSTREAM=rtsp://user:password@192.168.1.50:554/Streaming/Channels/102

# Names this camera in alerts and in config/zones.yaml.
FSBD_CAMERA_ID=cam_01

# Requested capture resolution. Cameras may ignore it - the app logs and the Camera
# page reports what is ACTUALLY being streamed, which matters because pixel thresholds
# (identity minimum box height, small-object recall) are tuned for the configured size.
FSBD_CAMERA_WIDTH=1280
FSBD_CAMERA_HEIGHT=720
FSBD_CAMERA_FPS=30

# How fast we pull frames for inference. A property of what THIS machine can keep up
# with, which is why it is here and not in app.yaml. Person detection runs on every
# person_every_n-th of these, so decode 12 with person_every_n 2 gives ~6 Hz detection -
# and zone hysteresis is counted in those detection frames.
FSBD_DECODE_FPS=12

# false serves the dashboard without opening the camera - useful for reviewing zones
# on a machine with no camera attached.
FSBD_AUTOSTART_CAMERA=true

# --- Dashboard ---------------------------------------------------------------
# 127.0.0.1 by design: the API has NO authentication, and anyone who can reach it can
# redraw the zones that arm the site. Binding to 0.0.0.0 needs a reverse proxy with
# auth in front of it.
FSBD_API_HOST=127.0.0.1
FSBD_API_PORT=8000

# --- Alerts (Phase 4) --------------------------------------------------------
# Telegram: create a bot with @BotFather, then message it once to get your chat id.
# FSBD_TELEGRAM_TOKEN=123456789:AA...
# FSBD_TELEGRAM_CHAT_ID=-1001234567890

# MQTT, if alerts route into an existing BMS/SCADA instead.
# FSBD_MQTT_HOST=192.168.1.10
# FSBD_MQTT_PORT=1883
# FSBD_MQTT_USER=
# FSBD_MQTT_PASSWORD=

# SMTP, if email alerts.
# FSBD_SMTP_HOST=
# FSBD_SMTP_PORT=587
# FSBD_SMTP_USER=
# FSBD_SMTP_PASSWORD=

# --- Paths (optional overrides) ----------------------------------------------
# FSBD_CONFIG=config/app.yaml
# FSBD_ZONES=config/zones.yaml
