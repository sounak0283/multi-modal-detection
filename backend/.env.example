# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#
# This file holds PER-DEPLOYMENT facts: this camera, this machine, this site. They
# differ per install, so committing them would mean the repository carried one site's
# wiring as if it were product configuration - and every install would conflict on it.
#
# Engineering constants - inference cadences, K-of-N gates, hysteresis defaults - live
# in config/app.yaml instead, because those are identical across installs and worth
# having in git history.
#
# The dashboard's Camera page writes this file directly (dotenv set_key). Hand-editing
# is equally fine; the app reads it on start and after every save.

# --- Camera (dev-mode bootstrap only) -----------------------------------------
# Since Expansion Plan Phase A, real camera configuration lives in MongoDB (any number
# of cameras, managed from the dashboard's Cameras page / the /api/cameras API) - these
# variables only seed the FIRST camera into an empty registry, so a fresh install still
# works from `perimeter-dashboard` alone without a dashboard visit first. They are ignored
# once at least one camera already exists.
#
# The switch: false reads PERIMETER_CAMERA_SOURCE (laptop webcam), true reads
# PERIMETER_CCTV_RTSP_URL (site CCTV). Same pattern as the sibling face-recognition
# deployment, so the two projects configure the same way.
PERIMETER_USE_CCTV=false

# Used when PERIMETER_USE_CCTV=false. A bare number is a device index; anything else is
# treated as a video file path, which is how you develop against recorded clips.
PERIMETER_CAMERA_SOURCE=0

# Used when PERIMETER_USE_CCTV=true. Contains the camera password - this is the main reason
# the file is git-ignored.
PERIMETER_CCTV_RTSP_URL=

# Optional low-resolution substream for inference while the main stream is recorded.
# If the camera exposes one this is the cheapest performance win available: it removes
# almost all decode cost (PLAN.md section 11).
# PERIMETER_CAMERA_SUBSTREAM=rtsp://user:password@192.168.1.50:554/Streaming/Channels/102

# Names this camera in alerts and in the zones collection.
PERIMETER_CAMERA_ID=cam_01

# Requested capture resolution. Cameras may ignore it - the app logs and the Camera
# page reports what is ACTUALLY being streamed, which matters because pixel thresholds
# (identity minimum box height, small-object recall) are tuned for the configured size.
PERIMETER_CAMERA_WIDTH=1280
PERIMETER_CAMERA_HEIGHT=720
PERIMETER_CAMERA_FPS=30

# How fast we pull frames for inference. A property of what THIS machine can keep up
# with, which is why it is here and not in app.yaml. Person detection runs on every
# person_every_n-th of these, so decode 12 with person_every_n 2 gives ~6 Hz detection -
# and zone hysteresis is counted in those detection frames.
PERIMETER_DECODE_FPS=12

# false serves the dashboard without opening the camera - useful for reviewing zones
# on a machine with no camera attached.
PERIMETER_AUTOSTART_CAMERA=true

# --- Storage (MongoDB) --------------------------------------------------------
# Camera configuration, zone definitions and every alert live here (Expansion Plan
# Phase A). Point this at a self-hosted MongoDB or an Atlas cluster:
#     PERIMETER_MONGO_URL=mongodb://localhost:27017
#     PERIMETER_MONGO_URL=mongodb+srv://user:pass@cluster0.mongodb.net
#
# Contains a password, which is why it belongs in this file. Retention policy lives in
# config/app.yaml instead, because that is a reviewable decision rather than a site fact.
#
# Unlike the project's original PostgreSQL-based design, this is REQUIRED at startup -
# camera and zone configuration live here too, not just alert history, so there is
# nothing to run without it. A MongoDB that drops out mid-run is still non-fatal for an
# already-running camera: detection outranks persistence for events already in flight.
PERIMETER_MONGO_URL=mongodb://localhost:27017
PERIMETER_MONGO_DB=perimeter

# --- Auth (Expansion Plan Phase B) --------------------------------------------
# Every route requires a logged-in session. On first run, if the `users` collection is
# empty, these two create the first (admin) account - required then, ignored once any
# account already exists (manage accounts from the dashboard's Users page after that).
PERIMETER_ADMIN_EMAIL=
PERIMETER_ADMIN_PASSWORD=

# Signs the session cookie. If left unset, a random one is generated at startup and
# logged as a warning - every session is then logged out on the next restart. Set this
# for sessions to survive a restart. Any long random string works, e.g.:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
PERIMETER_SESSION_SECRET=

# How long a session stays valid after login, in seconds. Default 12 hours.
# PERIMETER_SESSION_MAX_AGE_S=43200

# Mark the session cookie Secure (browser will only send it over https). Leave false for
# the http://127.0.0.1 quick-start default; set true once a reverse proxy is terminating
# TLS in front of the dashboard - a Secure cookie is silently dropped over plain http,
# which makes login LOOK like it worked and then every following request look logged-out.
PERIMETER_COOKIE_SECURE=false

# --- Dashboard ---------------------------------------------------------------
# 127.0.0.1 by design. Login is required for every route (see Auth above), but binding
# to 0.0.0.0 still needs a reverse proxy terminating TLS in front of it - auth over
# plain http on an open network still exposes credentials and session cookies.
PERIMETER_API_HOST=127.0.0.1
PERIMETER_API_PORT=8000

# --- Alerts (Expansion Plan Phase D) ------------------------------------------
# Telegram: create a bot with @BotFather, then message it once to get your chat id.
# Reserved - not implemented yet, only "smtp" is a valid alerts.sinks type today.
# PERIMETER_TELEGRAM_TOKEN=123456789:AA...
# PERIMETER_TELEGRAM_CHAT_ID=-1001234567890

# MQTT, if alerts route into an existing BMS/SCADA instead. Reserved, not implemented.
# PERIMETER_MQTT_HOST=192.168.1.10
# PERIMETER_MQTT_PORT=1883
# PERIMETER_MQTT_USER=
# PERIMETER_MQTT_PASSWORD=

# SMTP - implemented. Credentials only; routing (which severities, how often, who to)
# is policy and lives in config/app.yaml's alerts.sinks list instead, reviewable in git.
# At least one "type: smtp" entry there AND PERIMETER_SMTP_HOST here are both required
# for email alerts to actually go out - either alone is silently a no-op (logged).
# PERIMETER_SMTP_HOST=
# PERIMETER_SMTP_PORT=587
# PERIMETER_SMTP_USER=
# PERIMETER_SMTP_PASSWORD=
# PERIMETER_SMTP_FROM=              # defaults to PERIMETER_SMTP_USER if unset
# PERIMETER_SMTP_USE_TLS=true       # STARTTLS; set false only for a local/test relay

# --- Paths (optional overrides) ----------------------------------------------
# PERIMETER_CONFIG=config/app.yaml
# (there is no PERIMETER_ZONES any more - zones live in MongoDB, not a file, since
# Expansion Plan Phase A)
